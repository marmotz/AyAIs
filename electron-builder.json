{
  "asar": true,
  "productName": "AyAIs",
  "appId": "dev.marmotz.ayais",
  "publish": {
    "provider": "github",
    "owner": "marmotz",
    "repo": "AyAIs"
  },
  "directories": {
    "output": "release/"
  },
  "files": [
    "**/*",
    "!**/*.ts",
    "!*.map",
    "!package.json",
    "!package-lock.json",
    "dist/**/*",
    {
      "from": "../dist",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "dist/renderer/browser/assets/icons/win/icon.ico",
    "target": ["nsis"]
  },
  "nsis": {
    "artifactName": "Ayais-setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "icon": "dist/renderer/browser/assets/icons/mac/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "dist/renderer/browser/assets/icons/png/512x512.png",
    "target": ["AppImage", "deb"]
  }
}
